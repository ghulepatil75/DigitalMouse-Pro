<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="#0B0C0F">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Digital Mouse Pro" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:textColor="#AEB4C0" android:paddingTop="4dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
<Button android:id="@+id/wifiMode" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Wi-Fi"/>
<Button android:id="@+id/btMode" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Bluetooth"/>
</LinearLayout>
<LinearLayout android:id="@+id/wifiPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="7dp">
<EditText android:id="@+id/ip" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:hint="PC IP address" android:textColor="#FFFFFF" android:textColorHint="#777C87" android:singleLine="true"/>
<Button android:id="@+id/connect" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginStart="6dp" android:text="Connect"/>
</LinearLayout>
<TextView android:id="@+id/btInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bluetooth HID: tap Bluetooth, then pair the phone from Windows." android:textColor="#AEB4C0" android:visibility="gone" android:padding="8dp"/>
<com.ghulepatil.digitalmouse.TouchpadView android:id="@+id/touchpad" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
<Button android:id="@+id/left" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="LEFT"/>
<Button android:id="@+id/middle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:text="MIDDLE"/>
<Button android:id="@+id/right" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:text="RIGHT"/>
</LinearLayout>
<EditText android:id="@+id/keyboard" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Type to send keyboard input" android:textColor="#FFFFFF" android:textColorHint="#777C87" android:singleLine="true"/>
</LinearLayout>
